# ─── NetSuite Account ──────────────────────────────────────────────────────
# Account ID — visible in any NetSuite URL (e.g. 1234567 or 1234567_SB1).
# IMPORTANT: lowercase + replace underscores with hyphens for the host.
NS_ACCOUNT_ID=TSTDRV0000000

# RESTlet script + deployment ids (from src/Objects/customscript_rl_mt_salesorder.xml)
NS_RESTLET_SCRIPT_ID=customscript_rl_mt_salesorder
NS_RESTLET_DEPLOY_ID=customdeploy_rl_mt_salesorder

# ─── Token-Based Authentication (Setup → Users/Roles → Access Tokens) ─────
# Placeholders only — generate your own in NetSuite. Never commit real values.
NS_CONSUMER_KEY=your_consumer_key_here
NS_CONSUMER_SECRET=your_consumer_secret_here
NS_TOKEN_ID=your_token_id_here
NS_TOKEN_SECRET=your_token_secret_here

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to hit /api/*  (use * for any)
CORS_ORIGIN=http://localhost:3000
